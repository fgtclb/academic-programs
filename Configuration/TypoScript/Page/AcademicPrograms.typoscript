[page && traverse(page, "doktype") == 20]
  page {
    10 {
      // The page template of this page type.
      //
      // The name has to be set explicitly, because the identifier of the
      // backend layout does not survive every derivation a site package may
      // use. bk2k/bootstrap-package builds the name from the layout with
      // "case = uppercamelcase", which is
      // GeneralUtility::underscoredToUpperCamelCase() - and that lowercases
      // the whole string before it camel cases it on underscores. The
      // registered layout "pagets__AcademicProgram" therefore resolves to
      // "Academicprogram.html" and the page dies with an
      // InvalidTemplateResourceException.
      //
      // The clear is not decoration: bootstrap package assigns
      // "templateName.cObject", and a cObject overwrites the plain value in
      // ContentObjectRenderer::stdWrapValue(), so assigning without clearing
      // changes nothing.
      //
      // A PAGEVIEW page object ignores "templateName" and resolves the file
      // from "paths" below, so this is inert for that integration rather than
      // in its way.
      templateName >
      templateName = AcademicProgram

      // The paths of this extension sit at the key 50, below the 100 a site package
      // typically registers its own paths with. Two reasons:
      //
      // - A PAGEVIEW page object derives its layout and partial root paths from
      //   "paths", so a key of ours equal to the site package's replaced its whole
      //   directory on program pages: the page lost the layouts and partials of the
      //   site. A key of our own replaces nothing.
      // - An override of a project between 50 and 100 wins over this extension, and
      //   the site package's templates at 100 win over it as well - which is what an
      //   override of "Pages/AcademicProgram.html" in the site package means.
      //
      // The layout comes from the site package: this extension registers no layout at
      // 50, only the fallback below every other key.

      // Template path for PAGEVIEW based configurations
      paths {
        // The shared partials of EXT:academic_base ("Academic/Image"), which the page
        // template renders. A PAGEVIEW page object derives its partial and layout root
        // paths from "paths" and reads no "partialRootPaths" at all
        // (PageViewContentObject::render()), so the path is listed here as well - as
        // the directory above "Partials/", which is what that derivation appends.
        //
        // The key is the same negative one as below: it sorts under every key a theme
        // or project uses, and Fluid takes a file from the highest key that has it, so
        // the templates and partials of this extension and of the project still win.
        -1758484802 = EXT:academic_base/Resources/Private/
        // The fallback layout "Default", for a site package that ships none. Its own
        // directory at a key below every other one - see the layout itself.
        -1758484902 = EXT:academic_programs/Resources/Private/PageLayoutFallback/
        50 = EXT:academic_programs/Resources/Private/
      }

      // Template paths for FLUIDTEMPLATE based configurations
      templateRootPaths {
        50 = EXT:academic_programs/Resources/Private/Pages/
      }
      layoutRootPaths {
        // The fallback layout, as under "paths" above.
        -1758484902 = EXT:academic_programs/Resources/Private/PageLayoutFallback/Layouts/
      }
      partialRootPaths {
        // The shared partials of EXT:academic_base ("Academic/Image"), which the page
        // template renders. "page.10" belongs to the site package rather than to this
        // extension, so the key is a negative one of its own: it sorts below every
        // theme and project path, and it is unique across the academic extensions, so
        // it can neither replace one of those paths nor win over an override of
        // "Academic/Image".
        -1758484802 = EXT:academic_base/Resources/Private/Partials/
        50 = EXT:academic_programs/Resources/Private/Partials/
      }

      // The content elements of the main column, rendered through the "tt_content"
      // object of the site. A variable of the page object rather than a global
      // object path, so it exists on program pages only and needs no site set:
      // FLUIDTEMPLATE and PAGEVIEW both assign "variables".
      //
      // CONTENT applies the language and workspace overlays itself. "sorting"
      // is the manual order, "uid" the tiebreaker for equal values.
      //
      // To render another column, or to slide the content, change this
      // variable inside the same condition.
      variables {
        // The page layout the page template renders its section "Main" into, from the
        // site setting or constant "plugin.tx_academicprograms.page.layout". Empty
        // falls back to "Default" rather than to a layout without a name.
        programPageLayout = TEXT
        programPageLayout {
          value = {$plugin.tx_academicprograms.page.layout}
          ifEmpty = Default
        }

        // The list page the header links back to, "0" for no link.
        programListPid = TEXT
        programListPid {
          value = {$plugin.tx_academicprograms.page.listPid}
          intval = 1
        }

        programContent = CONTENT
        programContent {
          table = tt_content
          select {
            orderBy = sorting, uid
            where = {#colPos}=0
          }
        }
      }

      dataProcessing {
        100 = program-data
        110 = files
        110 {
          references.fieldName = media
          as = images
        }
      }
    }
  }
[END]
