# The shared TypoScript block of this extension.
#
# Every content element is driven by the one Extbase plugin namespace
# "plugin.tx_academicprograms", so the block is shipped once and every component
# folder names this folder in its "include_static_file.txt" instead of carrying
# a copy. The folder is the one "Configuration/TCA/Overrides/sys_template.php"
# has registered all along, so a "sys_template" record that stored it keeps
# working.
#
# It also carries the page object of the page type this extension registers.
# That block is conditioned on the doktype, so it is inert on every other page,
# and it belongs with the plugin configuration rather than with any single
# content element.
@import 'EXT:academic_programs/Configuration/TypoScript/Page/'

plugin.tx_academicprograms {
  settings {
    # The facts of the details content element and of the program card, see
    # "constants.typoscript". The program page reads its facts through the option
    # "factsFields" of its data processor instead.
    facts.fields = {$plugin.tx_academicprograms.facts.fields}
    card.fields = {$plugin.tx_academicprograms.card.fields}
    # The filters of the list and the finder, see "constants.typoscript". The field
    # "Filter types" in the FlexForm of either element overrides the filter types.
    filter.categoryTypes = {$plugin.tx_academicprograms.filter.categoryTypes}
    filter.visibleCount = {$plugin.tx_academicprograms.filter.visibleCount}
    filter.hideDisabledOptions = {$plugin.tx_academicprograms.filter.hideDisabledOptions}

    # The content element layout renders the header of every content element, so the
    # templates render it only for a site whose layout leaves it out. The header partial
    # falls back to the type of the header layout "Default" through the setting below,
    # which plugin settings do not carry the way the settings of `lib.contentElement` do.
    renderContentElementHeader = {$plugin.tx_academicprograms.renderContentElementHeader}
    defaultHeaderType = {$styles.content.defaultHeaderType}
  }

  # A list or finder element that leaves the field "Filter types" empty keeps the
  # value above: Extbase drops an empty FlexForm value of a setting listed here
  # before it merges the FlexForm over the TypoScript settings.
  ignoreFlexFormSettingsIfEmpty := addToList(filter.categoryTypes)

  view {
    templateRootPaths {
      0 = EXT:academic_programs/Resources/Private/Templates/
      1 = {$plugin.tx_academicprograms.view.templateRootPath}
    }

    partialRootPaths {
      # The header partial of EXT:fluid_styled_content, which the templates render while
      # "renderContentElementHeader" is switched on. The key sorts below every other one,
      # the shared partials of EXT:academic_base included, so a "Header/All" of the
      # project wins over it.
      -2 = EXT:fluid_styled_content/Resources/Private/Partials/
      # The shared partials of EXT:academic_base ("Academic/Image"). The key sorts below
      # the paths of this extension and of the project, so a partial of either wins over them.
      -1 = EXT:academic_base/Resources/Private/Partials/
      0 = EXT:academic_programs/Resources/Private/Partials/
      1 = {$plugin.tx_academicprograms.view.partialRootPath}
    }

    layoutRootPaths {
      0 = EXT:academic_programs/Resources/Private/Layouts/
      1 = {$plugin.tx_academicprograms.view.layoutRootPath}
    }
  }
}
