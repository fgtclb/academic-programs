plugin.tx_academicprograms {
  view {
    # cat=plugin.tx_academicprograms/file; type=string; label=Path to template root (FE)
    templateRootPath = EXT:academic_programs/Resources/Private/Templates/
    # cat=plugin.tx_academicprograms/file; type=string; label=Path to template partials (FE)
    partialRootPath = EXT:academic_programs/Resources/Private/Partials/
    # cat=plugin.tx_academicprograms/file; type=string; label=Path to template layouts (FE)
    layoutRootPath = EXT:academic_programs/Resources/Private/Layouts/
  }

  # The page of the program page type. Declared for site sets in
  # "Configuration/Sets/Full/settings.definitions.yaml" with the same defaults.
  page {
    # cat=plugin.tx_academicprograms/page; type=string; label=Page layout of program pages: the Fluid layout the program page renders its section "Main" into
    layout = Default
    # cat=plugin.tx_academicprograms/page; type=int+; label=Program list page: the page the header of a program page links back to, 0 for no link
    listPid = 0
  }

  # The facts of a program: comma-separated category type identifiers of the group
  # "programs" and the program fields creditPoints, jobProfile, performanceScope and
  # prerequisites, in display order. Declared for site sets in
  # "Configuration/Sets/Full/settings.definitions.yaml" with the same defaults.
  facts {
    # cat=plugin.tx_academicprograms/facts; type=string; label=Facts of the program page and the details element: empty shows every category type, and on the program page the four program fields after them
    fields =
  }

  card {
    # cat=plugin.tx_academicprograms/facts; type=string; label=Facts of the program card in the list: empty shows the degree
    fields = degree
  }

  # The category filters of the program list: comma-separated category type
  # identifiers of the group "programs", in the order the filter form offers them.
  # The program finder offers the same selects. The field "Filter types" of a list
  # or finder element overrides it for that element. How many of them the list
  # shows right away, and whether a filter leaves out the categories no listed
  # program carries - the finder follows the list in the latter. Declared for site
  # sets in "Configuration/Sets/Full/settings.definitions.yaml" with the same
  # defaults.
  filter {
    # cat=plugin.tx_academicprograms/filter; type=string; label=Filter types of the program list and the program finder: empty offers every category type with categories, and the degree and the topic in the finder
    categoryTypes =
    # cat=plugin.tx_academicprograms/filter; type=int+; label=Visible filters of the program list: how many filters are shown right away, the others behind "More filters"; 0 shows every filter
    visibleCount = 0
    # cat=plugin.tx_academicprograms/filter; type=boolean; label=Hide options without results in the program list and the program finder: leave out the categories no listed program carries instead of showing them disabled
    hideDisabledOptions = 0
  }
}
